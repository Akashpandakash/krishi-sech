APP_ENV=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
REQUEST_TIMEOUT_MS=20000
LOGGING_ENABLED=false
DEMO_LOGIN_ENABLED=false
DEBUG_OTP_ENABLED=false
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-4o-mini
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=30
DATABASE_URL=replace-with-production-database-url
JWT_ACCESS_SECRET=replace-with-production-access-secret
JWT_REFRESH_SECRET=replace-with-production-refresh-secret
OTP_HASH_SECRET=replace-with-production-otp-secret
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
FAST2SMS_API_KEY=replace-with-production-fast2sms-key
FAST2SMS_SENDER_ID=replace-with-approved-sender-id
FAST2SMS_ROUTE=replace-with-approved-route
OPENAI_API_KEY=replace-with-production-openai-key
