HOST=0.0.0.0
PORT=3000
MONGODB_URI=mongodb://localhost:27017/krishi_sech
MONGODB_DB_NAME=krishi_sech
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
OTP_HASH_SECRET=replace-with-a-long-random-otp-hash-secret
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=
APP_ENV=development
NODE_ENV=development
REQUEST_TIMEOUT_MS=20000
LOGGING_ENABLED=true
DEMO_LOGIN_ENABLED=true
DEBUG_OTP_ENABLED=true
# Comma-separated Google OAuth client IDs accepted as ID-token audiences.
# Use the WEB client ID (the app passes it as serverClientId).
GOOGLE_CLIENT_IDS=
AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Mandi prices (AGMARKNET via data.gov.in) -------------------------------
# Powers the Market tab's price list and the home screen ticker. Register a
# free key at https://data.gov.in/user/register and copy it from your profile.
# Without a key the API stays up and /api/mandi/prices answers 503
# MANDI_NOT_CONFIGURED, which the app renders as "prices unavailable".
DATA_GOV_API_KEY=
DATA_GOV_API_BASE_URL=https://api.data.gov.in/resource
# "Current Daily Price of Various Commodities from Various Markets (Mandi)".
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MANDI_TIMEOUT_MS=12000
# Upstream publishes once a day, so cache generously to protect the quota.
MANDI_CACHE_TTL_MS=1800000
MANDI_MAX_RECORDS=1000

TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=30

# Admin panel (website/admin)
ADMIN_JWT_ACCESS_SECRET=replace-with-a-long-random-admin-access-secret
ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-long-random-admin-refresh-secret
ADMIN_ACCESS_TOKEN_TTL_SECONDS=1800
ADMIN_REFRESH_TOKEN_TTL_SECONDS=43200
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_RATE_LIMIT_MAX=120

# Push delivery for admin broadcasts. Firebase service-account JSON, raw or
# base64. Without it broadcasts still reach the in-app notification inbox.
FCM_SERVICE_ACCOUNT=

# --- Firebase telemetry for the admin panel ---------------------------------
# Powers /admin/telemetry. Both integrations are optional: without them the
# panel shows setup instructions rather than empty charts.
#
# Service account JSON, raw or base64 (base64 survives dashboards that mangle
# multi-line secrets). Falls back to FCM_SERVICE_ACCOUNT when unset, since it
# is usually the same Firebase service account.
GOOGLE_TELEMETRY_SERVICE_ACCOUNT=
#
# ANALYTICS (Google Analytics Data API — Firebase Analytics is GA4 underneath)
#   1. Firebase console: confirm the project is linked to a GA4 property.
#   2. Google Analytics -> Admin -> Property settings: copy the NUMERIC
#      property id. It is not the G-XXXXXXX measurement id.
#   3. Google Analytics -> Admin -> Property access management: add the
#      service account email as a Viewer.
#   4. Google Cloud console: enable the "Google Analytics Data API".
GA4_PROPERTY_ID=
#
# CRASHLYTICS (via BigQuery — Crashlytics has NO public read API, so the
# BigQuery export is the only supported programmatic access)
#   1. Firebase console -> Project settings -> Integrations -> BigQuery:
#      enable it and tick Crashlytics.
#   2. Wait for the first export. The table is named
#      firebase_crashlytics.<package_with_underscores>_<PLATFORM>.
#   3. Grant the service account roles/bigquery.jobUser on the PROJECT
#      (running a query is a job) and roles/bigquery.dataViewer on the DATASET.
BIGQUERY_PROJECT_ID=
CRASHLYTICS_BIGQUERY_DATASET=firebase_crashlytics
CRASHLYTICS_BIGQUERY_TABLE=
# Upstream call timeout; BigQuery is slower than GA4.
TELEMETRY_TIMEOUT_MS=30000
