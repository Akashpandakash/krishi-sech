# Krishi Sech backend — STAGING
#
#   cp .env.staging.example .env      (from server/, on the staging host)
#
# Every `replace-with-*` value must be replaced. The server refuses to boot on
# some of them and silently degrades on others; each is marked below.
#
# Generate the five token secrets on the host, never in a chat or a ticket:
#   for k in JWT_ACCESS_SECRET JWT_REFRESH_SECRET OTP_HASH_SECRET \
#            ADMIN_JWT_ACCESS_SECRET ADMIN_JWT_REFRESH_SECRET; do
#     printf '%s=%s\n' "$k" "$(openssl rand -base64 48 | tr -d '\n')"
#   done
#
# UNDER DOCKER, four of these are overridden by docker-compose.yml and editing
# them here has no effect: HOST, PORT, CORS_ALLOWED_ORIGINS, and MONGODB_URI
# when ./.env sets it. Change those in ./.env at the repo root instead.

APP_ENV=staging
NODE_ENV=production
HOST=0.0.0.0
PORT=7001
REQUEST_TIMEOUT_MS=20000

# The server ENFORCES all three as false outside development and will not boot
# otherwise.
LOGGING_ENABLED=false
DEMO_LOGIN_ENABLED=false
DEBUG_OTP_ENABLED=false

# Exactly one trusted proxy (Nginx) sits in front. Without this every request
# appears to come from the proxy, so one farmer can exhaust everyone's OTP and
# rate-limit budget.
TRUST_PROXY=true

# Browser origins only — the admin panel's own origin, exact, comma separated,
# no trailing slash, no wildcard. The Flutter app sends no Origin header and
# does not need to be listed. Under Docker this comes from ./.env.
CORS_ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=30

# --- Database --------------------------------------------------------------
# REQUIRED. There is no in-memory fallback; the server exits without it.
# Use a staging cluster and a staging database name — never production's.
MONGODB_URI=replace-with-staging-mongodb-connection-string
MONGODB_DB_NAME=krishi_sech_staging

# --- Tokens and OTP --------------------------------------------------------
# Set these. Unlike production, staging does NOT refuse to boot without them —
# it falls back to `dev-access-secret-change-me` and friends, which are printed
# in this repository. A reachable staging host running those defaults can have
# its tokens forged by anyone who has read the source.
JWT_ACCESS_SECRET=replace-with-staging-access-secret
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret
OTP_HASH_SECRET=replace-with-staging-otp-secret
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600

# SMS delivery for login OTPs. Without these, staging cannot log a farmer in.
FAST2SMS_API_KEY=replace-with-staging-fast2sms-key
FAST2SMS_SENDER_ID=replace-with-approved-sender-id
FAST2SMS_ROUTE=replace-with-approved-route

# Comma-separated Google OAuth client IDs accepted as ID-token audiences.
# Use the WEB client ID (the app passes it as serverClientId).
GOOGLE_CLIENT_IDS=replace-with-web-oauth-client-id

# --- AI --------------------------------------------------------------------
# With AI_ENABLED=true the selected provider's key is REQUIRED in production
# and strongly advised here, or every AI call fails at request time.
AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=replace-with-staging-gemini-key
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Mandi prices (AGMARKNET via data.gov.in) ------------------------------
# Powers the Market tab's price list and the home ticker. Free key from
# https://data.gov.in/user/register. Without it /api/mandi answers 503 and the
# app shows "prices unavailable" — the admin panel can still serve prices an
# operator enters by hand, but the published feed will be missing.
DATA_GOV_API_KEY=
DATA_GOV_API_BASE_URL=https://api.data.gov.in/resource
# "Current Daily Price of Various Commodities from Various Markets (Mandi)".
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MANDI_TIMEOUT_MS=12000
# Upstream publishes once a day, so cache generously to protect the quota.
MANDI_CACHE_TTL_MS=1800000
MANDI_MAX_RECORDS=1000

# --- Admin panel -----------------------------------------------------------
# Same trap as the app's token secrets: staging silently uses
# `dev-admin-access-secret-change-me` when these are blank, so an unset value
# here means anyone can mint an admin session for this host.
ADMIN_JWT_ACCESS_SECRET=replace-with-a-long-random-admin-access-secret
ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-long-random-admin-refresh-secret
ADMIN_ACCESS_TOKEN_TTL_SECONDS=1800
ADMIN_REFRESH_TOKEN_TTL_SECONDS=43200
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_RATE_LIMIT_MAX=120

# Push delivery for admin broadcasts. Firebase service-account JSON, raw or
# base64. Without it broadcasts still reach the in-app notification inbox but
# no device notification is delivered — the panel says so on the Broadcasts
# screen rather than reporting a false success.
FCM_SERVICE_ACCOUNT=

# --- Firebase telemetry for the admin panel --------------------------------
# Optional. Without them /admin/telemetry shows setup instructions rather than
# empty charts. Falls back to FCM_SERVICE_ACCOUNT when unset.
GOOGLE_TELEMETRY_SERVICE_ACCOUNT=
# GA4 NUMERIC property id, not the G-XXXXXXX measurement id. The service
# account needs Viewer on the property and the Analytics Data API enabled.
GA4_PROPERTY_ID=
# Crashlytics has no public read API; the BigQuery export is the only way in.
# Grant roles/bigquery.jobUser on the project and dataViewer on the dataset.
BIGQUERY_PROJECT_ID=
CRASHLYTICS_BIGQUERY_DATASET=firebase_crashlytics
CRASHLYTICS_BIGQUERY_TABLE=
TELEMETRY_TIMEOUT_MS=30000
