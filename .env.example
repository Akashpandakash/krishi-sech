# Compose-level settings for docker-compose.yml. Copy to .env and adjust.
#
#   cp .env.example .env
#
# This file holds NO secrets and never should: backend credentials live in
# server/.env, which compose loads directly into the api container. Everything
# here is either a port, an image tag, or a public URL.

# Where the browser reaches the API. Baked into the admin panel's client bundle
# at image build time, so changing it needs `./scripts/docker.sh build web`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001

# Browser origins the API accepts. Must include the panel's own origin, exactly,
# and never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:7002

# Database the api container uses. Overrides MONGODB_URI in server/.env.
# Leave as-is for the bundled MongoDB; point it at Atlas for a hosted database.
MONGODB_URI=mongodb://mongo:27017/krishi_sech

# Published host ports.
API_PORT=7001
WEB_PORT=7002
MONGO_PORT=27017

MONGO_VERSION=7
