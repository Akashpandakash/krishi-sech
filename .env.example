# Compose-level settings for docker-compose.yml. Copy to .env and adjust.
#
#   cp .env.example .env
#
# Keep this file out of Git (.gitignore already covers .env). If you put a
# hosted MONGODB_URI here it carries a username and password, so treat the
# copy as a credential file even though the example holds none.

# Where the browser reaches the API. Baked into the admin panel's client bundle
# at image build time, so changing it needs `./scripts/docker.sh build web`.
# On a server this must be the address a browser can actually reach — a public
# hostname or IP, not localhost, unless you are tunnelling.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001

# Browser origins the API accepts. Must include the panel's own origin, exactly,
# and never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:7002

# Staging, with Nginx terminating TLS and proxying to 7001 and 7002:
#   NEXT_PUBLIC_API_BASE_URL=https://stage-api.krishisech.com
#   CORS_ALLOWED_ORIGINS=https://stage-admin.krishisech.com
# The CORS value is the PANEL's origin, not the API's — the browser sends it as
# the Origin header. Set server/.env TRUST_PROXY=true behind that Nginx, or
# rate limiting sees the proxy's IP for every farmer.

# Database. Leave commented to use the MONGODB_URI already in server/.env;
# uncomment to override it from here. One of the two must be set — the server
# has no in-memory fallback and refuses to start without it.
#
#   Atlas:     mongodb+srv://user:password@cluster.mongodb.net/krishi_sech
#   Bundled:   mongodb://mongo:27017/krishi_sech   (also set COMPOSE_PROFILES below)
#
# Never mongodb://localhost — inside a container that is the container itself.
#MONGODB_URI=

# Starts the bundled MongoDB service. Leave commented when using Atlas.
#COMPOSE_PROFILES=local-db

# Published host ports.
API_PORT=7001
WEB_PORT=7002
MONGO_PORT=27017

MONGO_VERSION=7
